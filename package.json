{
  "name": "csc-gerenciador",
  "version": "1.0.3",
  "description": "CSC Gerenciador — Suite de Desempenho, Aplicativos e Análise de Disco para Windows",
  "main": "src/main.js",
  "author": "CSC Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleitonlovable-png/cscgerenciadorwindows.git"
  },
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win nsis portable --publish never",
    "deploy:cf": "npx wrangler pages deploy src/renderer --project-name cscgerenciadorwindows --branch main --commit-dirty=true"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.csc.gerenciador",
    "productName": "CSC Gerenciador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cleitonlovable-png",
        "repo": "cscgerenciadorwindows",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CSC Gerenciador",
      "artifactName": "CSC-Gerenciador-Setup.exe"
    },
    "portable": {
      "artifactName": "CSC-Gerenciador-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
